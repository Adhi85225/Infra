# =============================================================================
# Global Infrastructure -- environment configuration
# =============================================================================
# Copy to `.env` and fill in real values:
#     cp .env.example .env
#
# `.env` is git-ignored. NEVER commit real secrets.
# Generate strong secrets with:  openssl rand -base64 48
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=Global Infrastructure
ENVIRONMENT=development           # development | test | production
DEBUG=false

# Public URL of the frontend. Used to build password-reset links in emails.
FRONTEND_BASE_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# Ports published on the Docker host (change if they clash locally)
# -----------------------------------------------------------------------------
API_PORT=8000
WEB_PORT=8080
POSTGRES_PORT=5434
REDIS_PORT=6380

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
POSTGRES_USER=ght
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=ght

# Used by the API. Inside Docker Compose the host is the service name `db`.
DATABASE_URL=postgresql+asyncpg://ght:change-me-in-production@db:5432/ght
DATABASE_ECHO=false

# -----------------------------------------------------------------------------
# Redis (rate limiting, permission cache, access-token revocation)
# -----------------------------------------------------------------------------
REDIS_ENABLED=true
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# Security  -- REQUIRED IN PRODUCTION
# -----------------------------------------------------------------------------
# Must be >= 32 characters. The app refuses to start in production without it.
JWT_SECRET=dev-insecure-secret-change-me
JWT_ALGORITHM=HS256

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=30

# Cookies: COOKIE_SECURE MUST be true in production (requires HTTPS).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax               # lax | strict | none
# COOKIE_DOMAIN=.example.internal

# -----------------------------------------------------------------------------
# Password policy
# -----------------------------------------------------------------------------
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=128
PASSWORD_REQUIRE_UPPER=true
PASSWORD_REQUIRE_LOWER=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SYMBOL=true
PASSWORD_HISTORY_DEPTH=3

# Argon2id cost. Defaults follow OWASP; production refuses values below
# 19456 KiB / 2 iterations. Raise if your hardware allows.
PASSWORD_HASH_TIME_COST=3
PASSWORD_HASH_MEMORY_COST_KIB=65536
PASSWORD_HASH_PARALLELISM=1

# -----------------------------------------------------------------------------
# Account lockout and rate limits ("requests/seconds")
# -----------------------------------------------------------------------------
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
RATE_LIMIT_LOGIN=10/60
RATE_LIMIT_FORGOT_PASSWORD=5/900
RATE_LIMIT_RESET_PASSWORD=10/900

# -----------------------------------------------------------------------------
# CORS -- comma-separated list of allowed frontend origins
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:8080,http://localhost:5174

# -----------------------------------------------------------------------------
# Email / SMTP
# -----------------------------------------------------------------------------
# EMAIL_TRANSPORT=log   -> messages are written to the API log (Phase 1 default).
#                          Password-reset links appear in `docker compose logs api`.
# EMAIL_TRANSPORT=smtp  -> real delivery. NOT IMPLEMENTED YET -- see docs/SMTP.md.
EMAIL_TRANSPORT=log

# SMTP settings are read but unused until real delivery is implemented.
# Fill these in when you are ready; do not put real credentials in git.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURE=starttls              # none | starttls | ssl
SMTP_FROM_EMAIL=no-reply@example.internal
SMTP_FROM_NAME=Global Infrastructure

# -----------------------------------------------------------------------------
# Bootstrap Super Admin (used by the seed only, and only on an empty database)
# -----------------------------------------------------------------------------
BOOTSTRAP_ADMIN_EMAIL=superadmin@example.internal
# Leave blank to have a strong password generated and printed once by the seed.
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FIRST_NAME=Super
BOOTSTRAP_ADMIN_LAST_NAME=Admin

# -----------------------------------------------------------------------------
# Frontend build-time configuration
# -----------------------------------------------------------------------------
# Base URL the browser uses to reach the API.
VITE_API_BASE_URL=http://localhost:8000
